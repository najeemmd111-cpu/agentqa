# Pick one (or none: AgentQA then runs fully offline with rule-based generation)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# anthropic | groq | offline | auto
AGENTQA_LLM=auto
# Optional model overrides
AGENTQA_ANTHROPIC_MODEL=claude-sonnet-5-5
AGENTQA_GROQ_MODEL=openai/gpt-oss-120b
# hashing (default, no download) | st (sentence-transformers, pip install .[embeddings])
AGENTQA_EMBEDDINGS=hashing
